JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me
JENKINS_URL=http://localhost:8080/
# Fine-grained personal access token with read-only access to the repository contents, metadata and pull requests.
GITHUB_USER=davidlescard
GITHUB_TOKEN=
# No registry token is needed: GitHub Actions pushes the image with its built-in token,
# and Jenkins pulls it anonymously because the GHCR package is public.
